<?xml version='1.0' encoding='utf-8' standalone='yes' ?>
<map>
    <!-- ============================================================
         LMC 8.4 — AllInOne_V3 Compatible
         Profile: LXX521_IMX682_Astrophotography_Ultra
         Target: Astrophotography & Deep-Sky Star Capture
         Sensor: IMX682 (Lava LXX521)
         ============================================================ -->

    <!-- Config identity -->
    <string name="pref_config_nickname_key">LXX521_IMX682_Astrophotography_Ultra</string>

    <!-- Main camera selection (rear IMX682) -->
    <string name="active_cam_id_back_key">0</string>
    <string name="pref_camera_id_back_key">0</string>

    <!-- Pixel 7 Pro color model -> base AWB color science -->
    <string name="pref_camera_model_back_key">18</string>
    <string name="pref_awb_back_key">18</string>
    <string name="pref_enable_awb_key">1</string>

    <!-- Maximum JPEG quality; astro stacks must not be re-compressed -->
    <string name="pref_qjpg_key">100</string>

    <!-- ===== Multi-Frame Capture (Astro: 12-16 frames) ===== -->
    <!-- 14 frames balances SNR against star trailing on a tripod -->
    <string name="frame_count_b_photo_0">14</string>
    <string name="frame_count_b_ns_0">14</string>
    <string name="pref_show_hdr_button_key">1</string>
    <string name="pref_show_exp_button_key">1</string>

    <!-- EXPERIMENTAL: No AllInOne_V3 key for 30s+ shutter speed or ISO cap.
         Enable pref_show_exp_button_key=1 on-device and manually set:
         - Exposure: 30s (max photon accumulation)
         - ISO: 1600-3200 fixed cap (starlight gain vs. thermal grain)
         Use a tripod; trailing increases beyond ~20-30s at wide angles. -->

    <!-- ===== Denoising ===== -->
    <string name="ptchr_lib_key_0">0</string>

    <!-- Maximum chroma denoise -> eliminates thermal hot pixels & purple/green sensor noise -->
    <string name="ptchr_chroma_denoise_0">2.00</string>

    <!-- Minimal luma denoise -> preserves faint pinprick stars, prevents star wipeout -->
    <string name="ptchr_luma_denoise_0">0.70</string>

    <!-- ===== Sharpening & Micro-Contrast ===== -->
    <!-- Tight small radius ~0.5 to sharpen stars without halos -->
    <string name="ptchr_sharp_radius_small_0">0.50</string>

    <!-- Moderate overall sharpness -> enhances star pinpoints without amplifying noise -->
    <string name="ptchr_sharpness_0">1.15</string>

    <!-- Reduced outline sharpness to prevent halos around bright stars -->
    <string name="ptchr_sharp_outline_0">0.85</string>

    <!-- ===== Color Science & AWB ===== -->
    <!-- Neutral saturation preserves true blue/red giant star colors -->
    <string name="ptchr_saturation_0">1.00</string>

    <!-- EXPERIMENTAL: No fixed Kelvin (4200-4500K daylight) key in AllInOne_V3.
         Lock AWB or set Daylight WB on-device to preserve star colors. -->

    <!-- ===== Dynamic Range & Black Level ===== -->
    <!-- Neutral contrast -> no crushing, no artificial sky glow -->
    <string name="ptchr_contrast_0">1.00</string>
    <string name="ptchr_contrast2_0">1.00</string>
    <string name="ptchr_dehaze_0">1.00</string>
    <string name="ptchr_hdr_effect_0">1.00</string>

    <!-- Aggressive deep black clamp -> pitch-black sky, no grey haze -->
    <string name="bl0_key_main">16.0</string>
    <string name="bl1_key_main">16.0</string>
    <string name="bl2_key_main">16.0</string>
    <string name="bl3_key_main">16.0</string>

    <!-- EXPERIMENTAL: No direct highlight-roll-off or tone-curve keys in AllInOne_V3. -->
</map>
