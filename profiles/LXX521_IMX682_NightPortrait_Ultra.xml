<?xml version='1.0' encoding='utf-8' standalone='yes' ?>
<map>
    <!-- ============================================================
         LMC 8.4 — AllInOne_V3 Compatible
         Profile: LXX521_IMX682_NightPortrait_Ultra
         Target: Night Portraits
         Sensor: IMX682 (Lava LXX521)
         ============================================================ -->

    <!-- Config identity -->
    <string name="pref_config_nickname_key">LXX521_IMX682_NightPortrait_Ultra</string>

    <!-- Main camera selection (rear IMX682) -->
    <string name="active_cam_id_back_key">0</string>
    <string name="pref_camera_id_back_key">0</string>

    <!-- Pixel 7 Pro color model -> natural skin-tone AWB -->
    <string name="pref_camera_model_back_key">18</string>
    <string name="pref_awb_back_key">18</string>
    <string name="pref_enable_awb_key">1</string>

    <!-- Maximum JPEG quality; portrait stacks must not be re-compressed -->
    <string name="pref_qjpg_key">100</string>

    <!-- ===== Multi-Frame Capture (Night Portrait: 12-15 frames) ===== -->
    <!-- 13 frames balances noise reduction vs. subject motion blur -->
    <string name="frame_count_b_photo_0">13</string>
    <string name="frame_count_b_ns_0">13</string>
    <string name="pref_show_hdr_button_key">1</string>
    <string name="pref_show_exp_button_key">1</string>

    <!-- EXPERIMENTAL: No AllInOne_V3 key for face retouch / beauty level.
         Skin smoothing is handled via moderate luma denoise below. -->

    <!-- ===== Denoising ===== -->
    <string name="ptchr_lib_key_0">0</string>

    <!-- High chroma denoise -> eliminates color splotches on skin/clothing -->
    <string name="ptchr_chroma_denoise_0">1.60</string>

    <!-- Moderate luma denoise -> softens skin texture without plastic look -->
    <string name="ptchr_luma_denoise_0">1.10</string>

    <!-- ===== Sharpening & Micro-Contrast ===== -->
    <!-- Tight radius ~0.6 to keep facial details & eyelashes sharp -->
    <string name="ptchr_sharp_radius_small_0">0.60</string>

    <!-- Slightly reduced sharpness -> avoids harsh skin texture / halos -->
    <string name="ptchr_sharpness_0">1.05</string>

    <!-- Reduced outline sharpness -> no halos around face/light edges -->
    <string name="ptchr_sharp_outline_0">0.90</string>

    <!-- ===== Color Science & AWB ===== -->
    <!-- Neutral saturation preserves natural skin tones under street lamps -->
    <string name="ptchr_saturation_0">1.00</string>

    <!-- EXPERIMENTAL: No dedicated face-retouch or skin-smoothing key in
         AllInOne_V3. Controlled indirectly via ptchr_luma_denoise_0 above. -->

    <!-- ===== Dynamic Range & Shadow Lift ===== -->
    <!-- +15% shadow recovery proxy for facial features / face brightening -->
    <string name="ptchr_hdr_effect_0">1.15</string>
    <string name="ptchr_contrast_0">1.02</string>
    <string name="ptchr_contrast2_0">1.00</string>
    <string name="ptchr_dehaze_0">1.00</string>

    <!-- Moderate black clamp -> detail in shadows without grey haze -->
    <string name="bl0_key_main">48.0</string>
    <string name="bl1_key_main">48.0</string>
    <string name="bl2_key_main">48.0</string>
    <string name="bl3_key_main">48.0</string>

    <!-- EXPERIMENTAL: No direct face-mask or portrait-blend key in AllInOne_V3. -->
</map>
