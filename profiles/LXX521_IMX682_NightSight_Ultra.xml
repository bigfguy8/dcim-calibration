<?xml version='1.0' encoding='utf-8' standalone='yes' ?>
<map>
    <!-- ============================================================
         LMC 8.4 — AllInOne_V3 Compatible
         Profile: LXX521_IMX682_NightSight_Ultra
         Target: Extreme Low-Light / Night Sight
         Sensor: IMX682 (Lava LXX521)
         ============================================================ -->

    <!-- Config identity -->
    <string name="pref_config_nickname_key">LXX521_IMX682_NightSight_Ultra</string>

    <!-- Main camera selection (rear IMX682) -->
    <string name="active_cam_id_back_key">0</string>
    <string name="pref_camera_id_back_key">0</string>

    <!-- Pixel 7 Pro color model -> Pixel AWB color transformation -->
    <string name="pref_camera_model_back_key">18</string>
    <string name="pref_awb_back_key">18</string>
    <string name="pref_enable_awb_key">1</string>

    <!-- Maximum JPEG quality; night stacks should not be re-compressed -->
    <string name="pref_qjpg_key">100</string>

    <!-- ===== Multi-Frame Exposure & Capture (Night Sight) ===== -->
    <string name="frame_count_b_photo_0">24</string>
    <string name="frame_count_b_ns_0">24</string>
    <string name="pref_show_hdr_button_key">1</string>
    <string name="pref_show_exp_button_key">1</string>

    <!-- EXPERIMENTAL: No AllInOne_V3 key for exposure-time multiplier or
         ISO ceiling. Longer shutter + lower ISO is achieved implicitly via
         the high frame count; clamp ISO manually on-device if your build
         exposes a Night Sight exposure slider. -->

    <!-- ===== Denoising & Spatial Smoothing ===== -->
    <string name="ptchr_lib_key_0">0</string>

    <!-- Aggressive chroma denoise -> removes green/purple color noise in shadows -->
    <string name="ptchr_chroma_denoise_0">1.45</string>

    <!-- Moderate luma denoise -> smooths dark sky/background, preserves fine grain -->
    <string name="ptchr_luma_denoise_0">1.10</string>

    <!-- EXPERIMENTAL: No dedicated spatial-denoise-radius key in this schema.
         Controlled indirectly via ptchr_luma_denoise_0 + small sharp radius below. -->

    <!-- ===== Sharpening & Micro-Contrast ===== -->
    <!-- Small micro-sharpness radius (0.6–0.8 target) to avoid halos around lamps/buildings -->
    <string name="ptchr_sharp_radius_small_0">0.75</string>

    <!-- Reduced large/medium detail sharpness (~−10 % vs 1.20 baseline) so dark
         noise grain is not sharpened into visible artifacts -->
    <string name="ptchr_sharpness_0">1.08</string>

    <!-- Reduced outline sharpness to prevent haloing around bright light edges -->
    <string name="ptchr_sharp_outline_0">0.85</string>

    <!-- ===== Color Science & AWB ===== -->
    <!-- +8 % shadow saturation to avoid color washing in dark areas -->
    <string name="ptchr_saturation_0">1.08</string>

    <!-- EXPERIMENTAL: No red/blue ratio or AWB-tint key in AllInOne_V3.
         Neutralizing 2700K–3200K streetlamp cast relies on
         pref_awb_back_key=18 (Pixel color model) plus on-device AWB lock. -->

    <!-- ===== Dynamic Range & Tone Mapping ===== -->
    <!-- Mild shadow recovery / HDR effect (closest proxy to +10–15 % shadow lift) -->
    <string name="ptchr_contrast_0">1.02</string>
    <string name="ptchr_hdr_effect_0">1.10</string>
    <string name="ptchr_contrast2_0">1.00</string>
    <string name="ptchr_dehaze_0">1.00</string>

    <!-- Protected black levels -> no crushed blacks, no raised true blacks -->
    <string name="bl0_key_main">64.0</string>
    <string name="bl1_key_main">64.0</string>
    <string name="bl2_key_main">64.0</string>
    <string name="bl3_key_main">64.0</string>

    <!-- EXPERIMENTAL: No direct highlight-roll-off or tone-curve keys in
         AllInOne_V3. ptchr_hdr_effect_0 is only a proxy for shadow lift. -->
</map>
